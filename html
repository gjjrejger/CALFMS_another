#practice-areas {
    background: var(--dark);
    color: var(--light);
}

#practice-areas > p:first-child {
    color: #8f8f8f;
}

#practice-areas > h2 {
    max-width: 950px;
    margin-bottom: 30px;
}

#practice-areas > p:not(:first-child) {
    margin-bottom: 90px;
    color: #909090;
}


/* Editorial list instead of cards */

.practice-list {
    display: grid;
    grid-template-columns: 1fr 1fr;

    border-top: 1px solid var(--dark-line);
}

.practice-list article {
    position: relative;

    min-height: 230px;

    padding: 32px 35px 35px 0;

    border-bottom: 1px solid var(--dark-line);
}

.practice-list article:nth-child(even) {
    padding-left: 35px;
    border-left: 1px solid var(--dark-line);
}

.practice-list article::before {
    content: "0" counter(practice);
}

.practice-list {
    counter-reset: practice;
}

.practice-list article {
    counter-increment: practice;
}

.practice-list article::before {
    display: block;

    margin-bottom: 55px;

    color: #666;

    font-size: 0.7rem;
    letter-spacing: 0.1em;
}

.practice-list h3 {
    margin-bottom: 17px;

    font-size: clamp(1.25rem, 2vw, 1.65rem);
}

.practice-list p {
    max-width: 500px;

    color: #929292;
    font-size: 0.9rem;
}

.practice-list article {
    transition: background 0.35s ease;
}

.practice-list article:hover {
    background: rgba(255, 255, 255, 0.025);
}


