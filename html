#team {
    padding: 20px 7%;
    background: #f7f7f5;
}


/* Section heading */

#team > p:first-child {
    margin-bottom: 18px;

    font-size: 12px;
    font-weight: 70;
    letter-spacing: 0.18em;
    text-transform: uppercase;

    color: #777;
}

#team > h2 {
    max-width: 700px;
    margin: 0 0 60px;

    font-size: clamp(42px, 5vw, 72px);
    line-height: 0.95;
    font-weight: 500;
    letter-spacing: -0.04em;

    color: #111;
}


/* =========================================================
   TEAM GRID
========================================================= */

.team-grid {
    display: flex;
    flex-direction: column;
    gap: 10px;
}


/* =========================================================
   TEAM CARD
========================================================= */

.team-member {
    display: flex;
    flex-direction: column;

    width: 100%;

    background: #ffffff;
    border: 1px solid #e5e5e2;

    padding: 5px;

    transition:
        transform 0.3s ease,
        box-shadow 0.3s ease;
}

.team-member:hover {
    transform: translateY(-4px);

    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.07);
}


/* PHOTO + NAME */

.team-profile {
    display: flex;
    align-items: center;

    gap: 10px;

    margin-bottom: 10px;
}

.team-image {
    flex: 0 0 180px;

    width: 180px;
    height: 210px;

    overflow: hidden;

    background: #eee;
}

.team-image img {
    width: 50%;
    height: 50%;

    display: block;

    object-fit: cover;
}


/* NAME */

.team-profile-info {
    flex: 1;
}

.team-profile-info h3 {
    margin: 0 0 10px;

    font-size: 32px;
    line-height: 1.1;
    font-weight: 500;

    letter-spacing: -0.03em;

    color: #111;
}

.team-role {
    margin: 0;

    font-size: 12px;
    font-weight: 700;

    letter-spacing: 0.15em;
    text-transform: uppercase;

    color: #777;
}


/* DETAILS BELOW PROFILE */

.team-content {
    width: 70%;

    padding-left: 100px;
}

.team-content p:not(.team-role) {
    max-width: 850px;

    margin: 0 0 18px;

    font-size: 16px;
    line-height: 1.75;

    color: #555;
}


/* DIVINA - NO PHOTO */

.team-member.no-image .team-profile {
    min-height: 0;
}

.team-member.no-image .team-content {
    padding-left: 3;
}


/* MOBILE */

@media (max-width: 700px) {

    .team-member {
        padding: 25px;
    }

    .team-profile {
        align-items: flex-start;
        gap: 20px;
    }

    .team-image {
        flex: 0 0 120px;

        width: 120px;
        height: 150px;
    }

    .team-profile-info h3 {
        font-size: 24px;
    }

    .team-content {
        padding-left: 0;
    }

}


/* =========================================================
   PROFILE HEADER
   PHOTO + NAME
========================================================= */

.team-profile {
    display: flex;
    align-items: center;
    gap: 24px;

    margin-bottom: 35px;
}


/* Profile picture */

.team-image {
    flex: 0 0 145px;

    width: 145px;
    height: 175px;

    overflow: hidden;

    background: #e9e9e6;
}


.team-image img {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;
}


/* Name area */

.team-profile-info {
    flex: 1;
}


.team-profile-info h3 {
    margin: 0 0 10px;

    font-size: 27px;
    line-height: 1.1;
    font-weight: 500;
    letter-spacing: -0.025em;

    color: #111;
}


.team-role {
    margin: 0;

    font-size: 12px;
    font-weight: 700;

    letter-spacing: 0.14em;
    text-transform: uppercase;

    color: #777;
}


/* =========================================================
   BIOGRAPHY / DETAILS
========================================================= */

.team-content {
    width: 100%;
}


.team-content p:not(.team-role) {
    margin: 0 0 18px;

    max-width: 600px;

    font-size: 15px;
    line-height: 1.75;

    color: #555;
}


/* =========================================================
   PROFILE WITHOUT IMAGE
   DIVINA
========================================================= */

.team-member.no-image {
    justify-content: flex-start;

    min-height: 100%;
}


.team-member.no-image .team-profile {
    min-height: 175px;
}


.team-member.no-image .team-profile-info {
    width: 100%;
}


.team-member.no-image h3 {
    color: #111;
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 1000px) {

    #team {
        padding: 90px 5%;
    }

    .team-grid {
        grid-template-columns: repeat(2, 1fr);
    }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 650px) {

    #team {
        padding: 75px 6%;
    }

    #team > h2 {
        margin-bottom: 40px;

        font-size: 44px;
    }

    .team-grid {
        grid-template-columns: 1fr;

        gap: 24px;
    }


    .team-member {
        padding: 24px;
    }


    /* Stack photo and name on small screens */

    .team-profile {
        align-items: flex-start;
        gap: 18px;
    }


    .team-image {
        flex: 0 0 110px;

        width: 110px;
        height: 135px;
    }


    .team-profile-info h3 {
        font-size: 23px;
    }


    .team-content p:not(.team-role) {
        font-size: 14px;
        line-height: 1.7;
    }

}




